{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/data/**": true,
    "**/.cache/**": true,
    "**/geolibre-dist/**": true,
    "**/release/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/.cache": true,
    "**/geolibre-dist": true,
    "**/release": true
  },
  "python.analysis.exclude": ["**/vendor/**", "**/.cache/**", "**/node_modules/**"],
  "gradle.autoDetect": "off",
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false
}
