# Opzioni di build di GeoLibre, lette da build/scripts/build-geolibre.mjs.
#
# Qui va solo ciò che si decide una volta per tutte le installazioni. Ciò che
# cambia da un'installazione all'altra (origini embed, relay, catalogo servizi)
# non sta qui: lo scrive il server Sestante in /gis/geolibre-runtime-config.js.

# GEOLIBRE_APP_BASE non sta qui: è <APP_BASE>gis/ e lo calcola build-geolibre.mjs
# dal percorso dell'app (APP_BASE, default "/").

# Nessun riferimento a unpkg/jsdelivr: DuckDB, PGlite e GDAL entrano nel build.
GEOLIBRE_NO_EXTERNAL_CDN=1

# La procedura guidata del primo avvio non ha senso dentro Sestante.
VITE_WELCOME_DISABLED=1

# Niente Share né Galleria verso share.geolibre.app: le mappe le gestisce Sestante.
VITE_GEOLIBRE_SHARE_URL=off
