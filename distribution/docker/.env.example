# Configurazione del compose. Copia in distribution/docker/.env e cambia TUTTI i segreti.
# Per generarne uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ── Indirizzo pubblico ───────────────────────────────────────────────────────
# Tutto (app, Keycloak, relay) sta su https://SESTANTE_HOST:SESTANTE_HTTPS_PORT
SESTANTE_HOST=localhost
SESTANTE_HTTPS_PORT=8443
SESTANTE_HTTP_PORT=8080
# Percorso sotto cui pubblicare tutto (app, Keycloak, relay): "/" oppure ad
# esempio "/sestante/". Cambiarlo richiede di ricostruire l'immagine
# (docker compose up -d --build): GeoLibre lo fissa nel proprio build.
SESTANTE_APP_BASE=/
# "internal" = CA locale di Caddy. Per un dominio pubblico: la tua email
# (Let's Encrypt), con SESTANTE_HTTPS_PORT=443 e SESTANTE_HTTP_PORT=80.
CADDY_TLS=internal

# ── Segreti ──────────────────────────────────────────────────────────────────
SESSION_SECRET=cambiami-sessione
POSTGRES_PASSWORD=cambiami-postgres
KEYCLOAK_CLIENT_SECRET=cambiami-client
COLLAB_IDENTITY_SECRET=cambiami-collab
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiami-admin

# Utente di default di Sestante (account locale), creato al primo avvio.
# Lascia vuota la password per farla generare: la trovi una volta sola in
#   docker compose logs sestante
DEFAULT_USER_EMAIL=admin@example.org
DEFAULT_USER_PASSWORD=cambiami-admin-2026

# Password dell'utente di prova anna.verdi@example.org nel realm importato.
# Si legge solo al primo avvio di Keycloak (import del realm).
DEMO_USER_PASSWORD=Sestante-demo-2026

# ── Sestante ─────────────────────────────────────────────────────────────────
# false: si entra solo con Keycloak. true: anche registrazione locale.
ALLOW_LOCAL_SIGNUP=false
ORG_DOMAIN=example.org
ORG_LABEL=example.org
