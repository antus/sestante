{
  "name": "sestante",
  "version": "0.1.0",
  "private": true,
  "description": "Sestante — spazio di lavoro cartografico multi-utente su motore GeoLibre",
  "author": "Massimo Antonini <massimo.anto@gmail.com>",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "src/server",
    "src/web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node build/scripts/setup.mjs",
    "db:reset": "npm run db:reset -w @sestante/server",
    "dev": "node build/scripts/check-node.mjs && node build/scripts/dev.mjs",
    "dev:server": "npm run dev -w @sestante/server",
    "dev:web": "npm run dev -w @sestante/web",
    "build": "npm run build -w @sestante/server && npm run build -w @sestante/web",
    "start": "node build/scripts/check-node.mjs && npm run start -w @sestante/server",
    "test": "npm run test -w @sestante/server && npm run test:pg -w @sestante/server && npm run test -w @sestante/web",
    "relay": "node build/scripts/relay.mjs",
    "build:geolibre": "node build/scripts/build-geolibre.mjs",
    "build:exe": "node distribution/portable/build-exe.mjs",
    "geolibre:use": "node build/scripts/geolibre-use.mjs",
    "test:e2e": "playwright test -c tests/e2e/local.config.ts",
    "test:e2e:stack": "playwright test -c tests/e2e/stack.config.ts",
    "test:e2e:dist": "playwright test -c tests/e2e/dist.config.ts",
    "test:security": "playwright test -c tests/security/security.config.ts",
    "test:security:zap": "node tests/security/zap/scan.mjs",
    "test:performance": "node tests/performance/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
