# ─────────────────────────────────────────────────────────────────────────────
# Sestante — configurazione. Copia questo file in .env e adatta i valori.
# Nessuna variabile è obbligatoria per il primo avvio: senza Keycloak resta
# attiva la sola autenticazione locale, senza relay la presenza è disattivata.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ------------------------------------------------------------------
# local (default): una postazione, segreto di sessione generato da solo.
# server: installazione condivisa, SESSION_SECRET obbligatorio, ascolto su 0.0.0.0.
SESTANTE_MODE=local
PORT=4000
HOST=127.0.0.1
# Origine pubblica dell'app: usata per i redirect OIDC e per i link di condivisione.
PUBLIC_URL=http://localhost:5173

# Segreto di firma dei cookie di sessione. OBBLIGATORIO in produzione.
# Generane uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-change-me

# Cartella dei dati (database, file caricati, segreto generato in locale).
# DATA_DIR=./.out/data

# PostgreSQL al posto di SQLite (installazione condivisa). Vuoto = SQLite.
# DATABASE_URL=postgres://sestante:password@127.0.0.1:5432/sestante

# Percorso del file SQLite. Vuoto = sestante.sqlite dentro DATA_DIR.
DATABASE_PATH=./.out/data/sestante.sqlite

# Cartella dei file caricati dagli utenti (GeoJSON), accanto al database.
# Migrabile a MinIO o Apache Ozone senza toccare altro che src/server/src/storage.ts.
UPLOADS_PATH=./.out/data/uploads
# Tetto per singolo file caricato, in byte. Oltre i 4 MB il caricamento
# funziona solo con GeoLibre servita sullo stesso schema di Sestante: vedi la
# nota in docs/sviluppo/ARCHITETTURA.md.
UPLOAD_MAX_BYTES=67108864

# --- Autenticazione locale ---------------------------------------------------
# Consente la registrazione autonoma di nuovi utenti locali.
# In produzione si tiene false: gli utenti arrivano da Keycloak.
ALLOW_LOCAL_SIGNUP=true

# Dominio dell'organizzazione: usato per l'accesso "tutti in <dominio>".
ORG_DOMAIN=example.org
ORG_LABEL=example.org

# --- Keycloak (OIDC) ---------------------------------------------------------
# Lascia KEYCLOAK_ISSUER vuoto per disattivare l'SSO: il pulsante sparisce
# dalla pagina di login e l'app resta utilizzabile con le sole credenziali locali.
# Esempio: https://sso.example.org/realms/sestante
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=sestante
KEYCLOAK_CLIENT_SECRET=
# Deve combaciare con il Valid redirect URI configurato sul client Keycloak.
KEYCLOAK_REDIRECT_URI=http://localhost:4000/api/auth/keycloak/callback
# Claim da cui leggere il nome visualizzato e i gruppi.
KEYCLOAK_SCOPES=openid profile email

# --- Relay di collaborazione (geolibre-collab-node) --------------------------
# URL HTTP del relay self-hosted. Vuoto = presenza disattivata.
# Il relay è prodotto da `npm run build:geolibre` e si avvia con `npm run relay`.
COLLAB_URL=http://127.0.0.1:8787
# Indirizzo del relay visto dal browser, se diverso da COLLAB_URL (dietro un
# proxy). GeoLibre accetta solo wss://, o ws:// su localhost.
# COLLAB_PUBLIC_URL=wss://mappe.example.org/collab
# 1 = il server ospita il relay nel proprio processo, sulla porta di COLLAB_URL,
# con segreto generato da sé (è il modo dell'eseguibile). Niente `npm run relay`.
# COLLAB_EMBEDDED=1
# DEVE essere identico al COLLAB_IDENTITY_SECRET del relay: è il segreto con cui
# Sestante firma gli identityToken che il relay verifica in HMAC-SHA256.
COLLAB_IDENTITY_SECRET=dev-only-change-me-too
# Durata dell'identityToken emesso ai client, in secondi.
COLLAB_IDENTITY_TTL=900

# --- GeoLibre ----------------------------------------------------------------
# Vuoto = GeoLibre servito da Sestante su /gis/, dal build in .out/geolibre/web
# (npm run build:geolibre). Se il build non c'è si ripiega sull'istanza pubblica.
# Un URL assoluto forza un'istanza esterna.
# GEOLIBRE_URL=https://web.geolibre.app
# GEOLIBRE_DIST=./.out/geolibre/web

# Catalogo di servizi (WMS/WMTS/WFS/XYZ…) proposto in GeoLibre, stesso formato
# di GEOLIBRE_SERVICES_FILE dell'immagine Docker: { "services": [ … ] }.
# GEOLIBRE_SERVICES_FILE=./geolibre/services.json
# off = nasconde i servizi di esempio di GeoLibre.
# GEOLIBRE_BUILTIN_SERVICES=off
